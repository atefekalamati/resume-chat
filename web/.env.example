# Use ONE provider. Copy this file to .env.local and fill in a key.
# Checked in this order: Gemini, OpenAI, OpenRouter.

# Google AI Studio (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, default: gemini-3.8-flash
GEMINI_MODEL=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Required when OPENAI_API_KEY is set, e.g. a model id from https://platform.openai.com/docs/models
OPENAI_MODEL=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, default: openrouter/auto
OPENROUTER_MODEL=
